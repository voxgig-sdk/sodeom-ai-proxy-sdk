# Entity: ain

main: kit: entity: ain: {

  alias: field: {}

  fields: [
    {
      name: "answer"
      req: true
      short: "Generated text response from the AI model"
      type: "`$STRING`"
    }
    {
      name: "max_tokens"
      req: false
      short: "Maximum tokens for the response"
      type: "`$INTEGER`"
    }
    {
      name: "messages"
      req: true
      short: "Chat history array passed to the model"
      type: "`$ARRAY`"
    }
    {
      name: "model"
      req: false
      short: "Overrides the default model (gpt-4o-mini)"
      type: "`$STRING`"
    }
    {
      name: "temperature"
      req: false
      short: "Sampling temperature passed through to the model (0.0 to 2.0)"
      type: "`$NUMBER`"
    }
  ]

  name: "ain"
  op: {
    create: {
      name: "create"
      points: [
        {
          method: "POST"
          orig: "/ai"
          parts: [
            "ai"
          ]
          transform: {
            req: "`reqdata`"
            res: "`body`"
          }
        }
      ]
    }
    load: {
      name: "load"
      points: [
        {
          args: {
            query: [
              {
                example: "Say hi"
                kind: "query"
                name: "query"
                orig: "query"
                reqd: true
                type: "`$STRING`"
              }
            ]
          }
          method: "GET"
          orig: "/ai"
          parts: [
            "ai"
          ]
          select: {
            exist: [
              "query"
            ]
          }
          transform: {
            req: "`reqdata`"
            res: "`body`"
          }
        }
      ]
    }
  }



}
